src/analysis/firm_growth_listed_controls.py
src/data/harmonized_firm_panels.py
tests/test_firm_growth.py
tests/test_harmonized_firm_panels.py

# Superseded deflator vintages; the empirical code uses only the 2005--2025 file.
data/gdp_deflator_2005_2022.csv
data/gdp_deflator_2010_2022.csv
