# Keep the public open-data inputs (Eurostat / OECD CSV under data/).
!data/*.csv

# Manuscript (LaTeX sources, figures, compiled PDF): the deliverable, kept out of the published
# code repository. reproduce.py regenerates the figure CSVs and paper_results.json on disk, and
# check_manuscript.py reads the .tex on disk; neither needs the manuscript tracked.
manuscript/

# Internal working notes (session logs, drafts): not part of the published repository.
docs/internal/

# Extension-only open inputs, not consumed by reproduce.py's paper pipeline (kept on disk for
# documented extensions, out of the published repo). Re-excluded after the !data/*.csv keep rule.
data/dividend_tax_rate_2010_2022.csv
data/dividends_cross_country_broad.csv
data/dividends_world.csv
data/house_prices.csv
data/household_flows_fr.csv
data/framing_fr.csv

# Third-party reference PDFs (copyrighted): kept locally, never published.
docs/reference/

# Final estimation samples used by the paper. These are the only firm-level Parquets admitted to
# the repository; .gitattributes stores them through Git LFS.
!data/derived/
data/derived/*
!data/derived/square_samples_canonical/
data/derived/square_samples_canonical/*
!data/derived/square_samples_canonical/*.parquet
!data/derived/square_samples_canonical/manifest.json
!data/derived/square_samples_canonical/recent_coverage.csv
# This unused complete-window intersection is retained locally but is not consumed by the paper.
data/derived/square_samples_canonical/private_large_vl_2018_full_complete.parquet

# Local-only construction and acquisition pipeline. The replication package starts from the final
# estimation samples above.
build_harmonized_firm_panels.py
scripts/fetch_*.py
run_firm_growth.py
run_firm_growth_controls.py
run_firm_growth_listed_controls.py
